{
  "name": "test",
  "version": "1.0.0",
  "description": "\"# mytest\"",
  "homepage": "https://github.com/SuphakonCh/mytest#readme",
  "bugs": {
    "url": "https://github.com/SuphakonCh/mytest/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuphakonCh/mytest.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run test:unit",
    "test:unit": "node dist/Test1.js",
    "test:integration": "node dist/IntegrationTest.js",
    "dev": "nodemon --watch src --ext ts --exec \"npm run build && npm test\"",
    "start:server": "npm run build && node --env-file=.env dist/index.js",
    "dev:server": "nodemon --watch src --watch public --ext ts,html,css,js --exec \"npm run build && node --env-file=.env dist/index.js\""
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mongodb": "^7.7.0",
    "mongoose": "^9.10.4"
  }
}
